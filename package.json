{
  "name": "snippet-inserter",
  "version": "1.1.1",
  "private": true,
  "description": "Browser extension that inserts saved text snippets into text fields and Google Docs with a double tap of Ctrl.",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:docs-live": "playwright test --config playwright.live.config.js",
    "browsers": "playwright install chromium --no-shell",
    "icons": "python scripts/make-icons.py"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
